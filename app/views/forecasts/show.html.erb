<% content_for :title, "Прогнозы — Rateflow" %>
<% content_for :head do %>
  <%# Vendored (not CDN) so the charts still render with no internet access. %>
  <%= javascript_include_tag "chart.umd", "data-turbo-track": "reload" %>
<% end %>

<div data-controller="forecasts" class="page" style="padding:0">
  <div>
    <h1 class="page-title">Прогнозы курса</h1>
    <p class="page-sub">Снимки прогнозов АПЭКОН и модели Rateflow поверх факта ЦБ РФ: версии, их дрейф и точность</p>
  </div>

  <%# Shared controls: every block below obeys the same currency and source choice. %>
  <div class="controls">
    <%= render "shared/segment", scope: "forecasts", key: "currency", label: "Валюта", options: Rate::CURRENCIES.map { |c| [c, c] } %>
    <%= render "shared/segment", scope: "forecasts", key: "source", label: "Источники",
               options: [["apecon", "АПЭКОН"], ["internal", "Rateflow"], ["both", "Оба"]] %>
  </div>

  <section class="section">
    <div class="section__head">
      <%= render "shared/icon", name: "chart" %>
      <h2 class="section__title">Прогноз поверх факта</h2>
    </div>
    <div class="card chart-card">
      <div class="chart-wrap"><canvas data-forecasts-target="mainCanvas" role="img" aria-label="Прогноз поверх фактического курса"></canvas></div>
      <div class="playback" data-forecasts-target="playback" hidden>
        <button type="button" class="playback__btn" data-forecasts-target="playBtn" data-action="forecasts#togglePlay"
                aria-label="Проиграть историю прогноза">▶</button>
        <input type="range" class="playback__slider" min="0" max="0" value="0" step="1"
               data-forecasts-target="playSlider" data-action="input->forecasts#scrub" aria-label="Версия прогноза">
        <span class="playback__label" data-forecasts-target="playLabel"></span>
      </div>
      <div class="legend" data-forecasts-target="mainLegend"></div>
      <div class="status-line" data-forecasts-target="mainStatus"></div>
    </div>
  </section>

  <section class="section">
    <div class="section__head">
      <%= render "shared/icon", name: "trend" %>
      <h2 class="section__title">Веер версий</h2>
    </div>
    <div class="card chart-card">
      <div class="chart-wrap"><canvas data-forecasts-target="fanCanvas" role="img" aria-label="Все версии прогноза одним веером"></canvas></div>
      <div class="status-line" data-forecasts-target="fanStatus"></div>
    </div>
  </section>

  <%# The page's most telling block: not the forecast itself but how it was
      revised — X is the snapshot date, Y is what was predicted back then for
      one fixed horizon date. %>
  <section class="section">
    <div class="section__head">
      <%= render "shared/icon", name: "convert" %>
      <h2 class="section__title">Как менялся прогноз на дату</h2>
      <div class="section__aside filters">
        <label class="control__label" for="horizon-date">Дата</label>
        <select id="horizon-date" class="select" data-forecasts-target="horizonSelect" data-action="forecasts#setHorizon"></select>
      </div>
    </div>
    <div class="card chart-card">
      <div class="chart-wrap"><canvas data-forecasts-target="revisionCanvas" role="img" aria-label="История пересмотров прогноза на выбранную дату"></canvas></div>
      <div class="legend" data-forecasts-target="revisionLegend"></div>
      <div class="status-line" data-forecasts-target="revisionStatus"></div>
    </div>
  </section>

  <%= render "accuracy", accuracy: @accuracy %>
</div>
