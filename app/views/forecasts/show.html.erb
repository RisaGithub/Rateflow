<% content_for :title, "Прогнозы — Rateflow" %>
<% content_for :description, "Снимки прогнозов АПЭКОН и модели Rateflow поверх факта ЦБ РФ: как менялись версии, куда дрейфует прогноз и какова его честная точность" %>
<% content_for :head do %>
  <%# Vendored (not CDN) so the charts still render with no internet access. %>
  <%= javascript_include_tag "chart.umd", "data-turbo-track": "reload" %>
<% end %>

<div data-controller="forecasts" class="page page--flush">
  <header class="card hero">
    <div>
      <h1 class="page-title">Прогнозы курса</h1>
      <p class="page-sub">Снимки прогнозов АПЭКОН и модели Rateflow поверх факта ЦБ РФ: версии, их дрейф и точность</p>
    </div>
    <%# Shared controls: every block below obeys the same currency, period and source choice. %>
    <div class="hero__controls controls">
      <%= render "shared/segment", scope: "forecasts", key: "currency", label: "Валюта", options: Rate::CURRENCIES.map { |c| [c, "#{currency_symbol(c)} #{c}"] } %>
      <div class="popover-anchor">
        <%= render "shared/segment", scope: "forecasts", key: "period", label: "Период",
                   options: [[30, "30 дн"], [90, "90 дн"], [365, "1 год"], [1825, "5 лет"], ["all", "Всё"], ["custom", "Свой"]] %>
        <%= render "shared/range_popover", scope: "forecasts" %>
      </div>
      <%= render "shared/segment", scope: "forecasts", key: "source", label: "Источники",
                 options: [["apecon", "АПЭКОН"], ["internal", "Rateflow"], ["both", "Оба"]] %>
    </div>
  </header>

  <% if @no_snapshots %>
    <%= render "shared/empty_notice",
               text: "Снимков прогнозов ещё нет: АПЭКОН и модель Rateflow сохраняют свои версии при плановых " \
                     "обновлениях, так что графики и таблица заполнятся в течение первого дня работы." %>
  <% end %>

  <section class="section">
    <div class="section__head">
      <span class="section__badge"><%= render "shared/icon", name: "chart" %></span>
      <h2 class="section__title">Прогноз поверх факта</h2>
    </div>
    <p class="section__desc">Свежая версия прогноза каждого источника продолжает фактическую линию ЦБ РФ.
      Плеер под графиком проигрывает прошлые версии — видно, что обещали раньше.</p>
    <div class="card chart-card chart-card--hero">
      <div class="chart-wrap"><canvas data-forecasts-target="mainCanvas" role="img" aria-label="Прогноз поверх фактического курса"></canvas></div>
      <div class="playback" data-forecasts-target="playback" hidden>
        <button type="button" class="playback__btn" data-forecasts-target="playBtn" data-action="forecasts#togglePlay"
                aria-label="Проиграть историю прогноза">▶</button>
        <input type="range" class="playback__slider" min="0" max="0" value="0" step="1"
               data-forecasts-target="playSlider" data-action="input->forecasts#scrub" aria-label="Версия прогноза">
        <span class="playback__label" data-forecasts-target="playLabel"></span>
      </div>
      <div class="legend" data-forecasts-target="mainLegend"></div>
      <div class="status-line" data-forecasts-target="mainStatus"></div>
    </div>
  </section>

  <div class="duo duo--charts">
    <section class="section">
      <div class="section__head">
        <span class="section__badge"><%= render "shared/icon", name: "trend" %></span>
        <h2 class="section__title">Веер версий</h2>
      </div>
      <p class="section__desc">Все сохранённые версии одним пучком: чем свежее версия, тем плотнее цвет —
        видно, куда дрейфует прогноз.</p>
      <div class="card chart-card">
        <div class="chart-wrap"><canvas data-forecasts-target="fanCanvas" role="img" aria-label="Все версии прогноза одним веером"></canvas></div>
        <div class="status-line" data-forecasts-target="fanStatus"></div>
      </div>
    </section>

    <%# The page's most telling block: not the forecast itself but how it was
        revised — X is the snapshot date, Y is what was predicted back then for
        one fixed horizon date. %>
    <section class="section">
      <div class="section__head">
        <span class="section__badge"><%= render "shared/icon", name: "convert" %></span>
        <h2 class="section__title">Как менялся прогноз на дату</h2>
        <div class="section__aside filters">
          <label class="control__label" for="horizon-date">Дата</label>
          <select id="horizon-date" class="select" data-forecasts-target="horizonSelect" data-action="forecasts#setHorizon"></select>
        </div>
      </div>
      <p class="section__desc">X — день снимка, Y — что в тот день обещали на выбранную дату:
        история пересмотров одного обещания.</p>
      <div class="card chart-card">
        <div class="chart-wrap"><canvas data-forecasts-target="revisionCanvas" role="img" aria-label="История пересмотров прогноза на выбранную дату"></canvas></div>
        <div class="legend" data-forecasts-target="revisionLegend"></div>
        <div class="status-line" data-forecasts-target="revisionStatus"></div>
      </div>
    </section>
  </div>

  <%= render "accuracy", accuracy: @accuracy %>

  <section class="section">
    <div class="section__head">
      <span class="section__badge"><%= render "shared/icon", name: "table" %></span>
      <h2 class="section__title">Снимки прогнозов</h2>
    </div>
    <p class="section__desc">Каждая строка — сохранённая версия прогноза; клик по строке кладёт её на главный график.</p>
    <div class="card table-wrap snapshots">
      <table>
        <thead>
          <tr><th>Дата и время снимка</th><th>Провайдер</th><th class="num">Точек</th><th>Дальний горизонт</th></tr>
        </thead>
        <tbody data-forecasts-target="snapshotsBody"></tbody>
      </table>
    </div>
    <div class="pager">
      <button type="button" class="pager__link" data-forecasts-target="pagerPrev" data-action="forecasts#prevPage" hidden>← Новее</button>
      <span class="pager__info" data-forecasts-target="pagerInfo"></span>
      <button type="button" class="pager__link" data-forecasts-target="pagerNext" data-action="forecasts#nextPage" hidden>Старше →</button>
    </div>
  </section>
</div>
