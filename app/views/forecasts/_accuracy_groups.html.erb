<%# No invented numbers: empty buckets show dashes, an empty card says in
    plain words why. The two providers are measured differently — АПЭКОН by
    its actually published forecasts, our own model by a historical backtest —
    and each card names its method so the numbers are never silently mixed.
    accuracy: { "USD" => [Report, ...], ... } — one group per currency, the
    page's shared switches pick which cards are visible.
    scoped: true when a period filter applies — the empty message names it. %>
<% accuracy.each do |currency, reports| %>
  <% comparable = reports.map { |r| r.buckets.filter_map { |label, bucket| label if bucket[:samples].positive? } }.reduce(:&) %>
  <div class="providers" data-forecasts-target="accuracyGroup" data-currency="<%= currency %>"
       <%= "hidden" unless currency == Rate::CURRENCIES.first %>>
    <% reports.each do |report| %>
      <div class="card provider <%= "provider--empty" if report.samples.zero? %>"
           data-forecasts-target="accuracyCard" data-provider="<%= report.provider %>">
        <div class="provider__head">
          <div>
            <h3 class="provider__name"><%= provider_name(report.provider) %> · <%= currency %></h3>
            <div class="provider__desc"><%= report.provider == "internal" ?
              "бэктест: прогнозы пересчитаны по историческим данным и сверены с фактом ЦБ РФ" :
              "фактически опубликованные прогнозы, сверенные с фактом ЦБ РФ" %></div>
          </div>
          <% unless report.samples.zero? %>
            <div class="stat stat--right">
              <div class="stat__label">Сравнений</div>
              <div class="stat__value"><%= report.samples %></div>
            </div>
          <% end %>
        </div>
        <% if report.samples.zero? %>
          <div class="accuracy-empty"><%= scoped ?
            "В выбранном периоде нет сбывшихся точек этого прогноза — попробуйте более длинный период." :
            "Пока нечего сравнивать: ни одна точка этого прогноза ещё не сбылась.
             Оценка появится, когда даты прогноза наступят и будет фактический курс ЦБ РФ." %></div>
        <% else %>
          <table class="accuracy-table">
            <thead>
              <tr><th>Горизонт прогноза</th><th class="num">Сравнений</th><th class="num">MAE, ₽</th><th class="num">MAPE</th></tr>
            </thead>
            <tbody>
              <% report.buckets.each do |label, bucket| %>
                <tr class="<%= comparable.include?(label) ? "is-comparable" : "is-dim" %>">
                  <td class="muted"><%= label %></td>
                  <td class="num"><%= bucket[:samples].zero? ? "—" : bucket[:samples] %></td>
                  <td class="num"><%= bucket[:samples].zero? ? "—" : rub(bucket[:mae], precision: 2) %></td>
                  <td class="num"><%= bucket[:samples].zero? ? "—" : "#{rub(bucket[:mape], precision: 2)}%" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
