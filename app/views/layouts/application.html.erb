<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <% title = content_for(:title) || "Rateflow — курсы валют к рублю" %>
    <% description = content_for(:description) || "Курсы валют к рублю из независимых источников: история, графики, прогнозы и их точность" %>
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= description %>">

    <%# Link previews in messengers and social feeds. %>
    <meta property="og:site_name" content="Rateflow">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="ru_RU">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="<%= request.base_url %>/og.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="<%= request.base_url %>/og.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_tag nonce: true do %>
      // Apply the saved theme before first paint to avoid a flash of the wrong theme.
      (function () { try { var t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {} })();
    <% end %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700&family=Onest:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body>
    <header class="topbar">
      <div class="container topbar__inner">
        <%= link_to root_path, class: "brand", "aria-label": "Rateflow" do %>
          <%= render "shared/icon", name: "logo" %>
          <span>Rateflow</span>
        <% end %>
        <nav class="nav">
          <%= link_to "Дашборд", root_path, class: "nav__link", "aria-current": (current_page?(root_path) ? "page" : nil) %>
          <%= link_to "Прогнозы", forecasts_path, class: "nav__link", "aria-current": (current_page?(forecasts_path) ? "page" : nil) %>
          <%= link_to "Источники", sources_path, class: "nav__link", "aria-current": (current_page?(sources_path) ? "page" : nil) %>
        </nav>
        <div class="topbar__tools">
          <%= link_to about_path, class: "icon-btn", "aria-label": "О проекте", title: "О проекте",
                      "aria-current": (current_page?(about_path) ? "page" : nil) do %>
            <%= render "shared/icon", name: "info" %>
          <% end %>
          <button type="button" class="icon-btn theme-toggle" data-controller="theme" data-action="theme#toggle" aria-label="Переключить тему" title="Переключить тему">
            <%= render "shared/icon", name: "sun", class: "theme-toggle__sun" %>
            <%= render "shared/icon", name: "moon", class: "theme-toggle__moon" %>
          </button>
        </div>
      </div>
    </header>

    <main class="container page">
      <% flash.each do |type, message| %>
        <div class="flash <%= "flash--alert" if type.to_s == "alert" %>" role="status"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="container footer">
      <span>Rateflow · данные ЦБ РФ, open.er-api.com, Currency API и АПЭКОН · <%= link_to "О проекте", about_path %></span>
      <span class="mono"><%= Date.current.strftime("%Y") %></span>
    </footer>
  </body>
</html>
