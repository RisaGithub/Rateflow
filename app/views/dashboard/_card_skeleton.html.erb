<%# Placeholder for one currency card. Same grid, same classes, same line
    heights as the real card, so the swap moves nothing: the grey blocks are
    just spans whose height comes from the very font metrics they stand in for. %>
<div class="card ccard ccard--skel swap__skel" aria-hidden="true">
  <div class="ccard__head">
    <span class="ccard__sym skel"></span>
    <div>
      <div class="ccard__code"><span class="skel skel-line">&nbsp;</span></div>
      <div class="ccard__name"><span class="skel skel-line">&nbsp;</span></div>
    </div>
  </div>
  <div class="ccard__spark skel"></div>
  <div class="ccard__value"><span class="skel skel-line">&nbsp;</span></div>
  <div class="ccard__src"><span class="skel skel-line">&nbsp;</span></div>
  <div class="ccard__delta"><span class="skel skel-line">&nbsp;</span></div>
</div>
