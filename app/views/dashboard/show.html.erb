<% content_for :description, "Курсы USD, EUR, CNY и GBP к рублю из четырёх независимых источников: карточки с трендом, график, конвертер и полная история" %>
<% content_for :head do %>
  <%# Vendored (not CDN) so the chart still renders with no internet access. %>
  <%= javascript_include_tag "chart.umd", "data-turbo-track": "reload" %>
<% end %>

<%# Nothing below is server-rendered from the database: the page is a shell of
    skeletons, and Stimulus fills it from /dashboard/data, /series and
    /forecasts/data once the HTML is on screen. %>
<div data-controller="dashboard" class="page page--flush">
  <div>
    <h1 class="page-title">Курсы валют к рублю</h1>
    <p class="page-sub">USD, EUR, CNY и GBP из четырёх независимых источников: ЦБ РФ, ER-API, Currency API и АПЭКОН</p>
  </div>

  <%# Raised from Stimulus when /dashboard/data reports an empty database. %>
  <div data-dashboard-target="emptyNotice" hidden>
    <%= render "shared/empty_notice",
               text: "База только что развёрнута: курсы подтянутся с первым плановым обновлением, " \
                     "обычно в течение пары часов. После этого здесь появятся карточки валют, график и история." %>
  </div>

  <section class="cards" aria-label="Валюты">
    <% Rate::CURRENCIES.each do |code| %>
      <div class="swap" data-dashboard-target="cardSlot" data-currency="<%= code %>">
        <%= render "card_skeleton" %>
      </div>
    <% end %>
  </section>

  <section class="section">
    <div class="section__head">
      <%= render "shared/icon", name: "chart" %>
      <h2 class="section__title">График</h2>
      <div class="section__aside controls">
        <%= render "shared/segment", scope: "dashboard", key: "currency", label: "Валюта", options: Rate::CURRENCIES.map { |c| [c, "#{currency_symbol(c)} #{c}"] } %>
        <div class="popover-anchor">
          <%= render "shared/segment", scope: "dashboard", key: "period", label: "Период",
                     options: [[7, "7 дн"], [30, "30 дн"], [90, "90 дн"], [365, "1 год"], [1825, "5 лет"], ["all", "Всё"], ["custom", "Свой"]] %>
          <%= render "shared/range_popover", scope: "dashboard" %>
        </div>
        <div class="control">
          <span class="control__label">Источники</span>
          <div class="chips" role="group" aria-label="Источники">
            <% Rate::PROVIDERS.each do |p| %>
              <label class="chip chip--<%= p %>">
                <input type="checkbox" value="<%= p %>" checked data-dashboard-target="sourceBox" data-action="dashboard#toggleSource">
                <span class="chip__dot" aria-hidden="true"></span>
                <span><%= provider_name(p) %></span>
              </label>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="card chart-card">
      <div class="chart-wrap" data-dashboard-target="chartWrap">
        <canvas data-dashboard-target="canvas" role="img" aria-label="График курса"></canvas>
        <div class="chart-skel skel swap__skel" aria-hidden="true"></div>
      </div>
      <div class="legend" data-dashboard-target="legend"><%= render "shared/skeleton_legend", items: 4 %></div>
      <div class="status-line" data-dashboard-target="diverge"><span class="skel skel-line skel-line--wide">&nbsp;</span></div>
      <div class="status-line" data-dashboard-target="status"><span class="skel skel-line skel-line--mid">&nbsp;</span></div>
    </div>
  </section>

  <section class="duo">
    <div class="section">
      <div class="section__head">
        <%= render "shared/icon", name: "trend" %>
        <h2 class="section__title">Прогноз</h2>
      </div>
      <%# Compact teaser: the nearest common forecast date from each source;
          everything deeper lives on the /forecasts page. %>
      <div class="card panel panel--fill" data-dashboard-target="forecast">
        <span class="skel skel-line skel-line--wide">&nbsp;</span>
        <div class="forecast-cells">
          <% 2.times do %>
            <div class="forecast-cell">
              <div class="panel__label"><span class="skel skel-line skel-line--mid">&nbsp;</span></div>
              <div class="panel__big"><span class="skel skel-line skel-line--mid">&nbsp;</span></div>
              <div class="forecast-cell__delta"><span class="skel skel-line skel-line--wide">&nbsp;</span></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="section__head">
        <%= render "shared/icon", name: "convert" %>
        <h2 class="section__title">Конвертер</h2>
      </div>
      <%# Rates arrive with /dashboard/data; the dashboard controller hands
          them over by writing this value. %>
      <div class="card panel panel--fill" data-controller="converter" data-dashboard-target="converter"
           data-converter-rates-value="{}">
        <div class="converter__grid">
          <div class="field">
            <label for="conv-amount">Сумма</label>
            <input id="conv-amount" class="input" type="number" inputmode="decimal" min="0" step="any" value="100"
                   data-converter-target="amount" data-action="input->converter#calc">
          </div>
          <div class="field">
            <label for="conv-currency">Валюта</label>
            <select id="conv-currency" class="select" data-converter-target="currency" data-action="converter#calc">
              <% Rate::CURRENCIES.each do |c| %><option value="<%= c %>"><%= currency_symbol(c) %> <%= c %></option><% end %>
            </select>
          </div>
        </div>
        <div class="control">
          <span class="control__label">Направление</span>
          <div class="seg" role="group">
            <button type="button" class="seg__btn" data-converter-target="dir" data-value="to_rub" data-action="converter#setDir" aria-pressed="true">В рубли</button>
            <button type="button" class="seg__btn" data-converter-target="dir" data-value="from_rub" data-action="converter#setDir" aria-pressed="false">Из рублей</button>
          </div>
        </div>
        <div class="converter__result">
          <div class="panel__label">Результат</div>
          <div class="panel__big" data-converter-target="result">—</div>
          <div class="panel__note" data-converter-target="note"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__head">
      <%= render "shared/icon", name: "table" %>
      <h2 class="section__title">История</h2>
      <div class="section__aside controls">
        <%= render "shared/segment", scope: "dashboard", key: "tableSource", label: "Источник",
                   options: [["all", "Все"]] + Rate::PROVIDERS.map { |p| [p, provider_name(p)] } %>
        <%= render "shared/segment", scope: "dashboard", key: "rows", label: "Строк", options: [[10, "10"], [30, "30"], [90, "90"]] %>
      </div>
    </div>
    <div class="card table-wrap">
      <table>
        <thead>
          <tr><th>Дата</th><th class="num">Курс, ₽</th><th class="num">Изменение</th><th class="num">%</th><th>Источник</th></tr>
        </thead>
        <tbody data-dashboard-target="tbody"><%= render "shared/skeleton_rows", cols: 5, rows: 8 %></tbody>
      </table>
    </div>
  </section>
</div>
