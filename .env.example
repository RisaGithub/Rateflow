# Copy to .env for development — .env is gitignored and loaded automatically
# in development and test (see config/application.rb). In production these
# are set in Render's dashboard instead (render.yaml marks them sync: false).

# Shared token guarding GET /cron/refresh and /cron/forecasts.
# Generate one with: openssl rand -hex 24. Unset → the endpoints answer 503.
CRON_TOKEN=

# HTTP Basic credentials for the /admin page. Unset → /admin answers 503.
ADMIN_USER=
ADMIN_PASSWORD=

# Production only: the Supabase *session pooler* connection string
# (postgresql://...pooler.supabase.com:5432/postgres). Development and test
# use the local rateflow_development / rateflow_test databases instead.
DATABASE_URL=

# Production only: decrypts config/credentials.yml.enc (secret_key_base).
# The value is the one line inside your local config/master.key.
RAILS_MASTER_KEY=

# Production only: extra allowed host besides *.onrender.com — set it after
# attaching a custom domain.
APP_HOST=

# Puma thread count and the Active Record pool size (kept equal). Render's
# blueprint sets 3 so the app fits Supabase's free connection limit.
RAILS_MAX_THREADS=

# Keeps the OS clock in Moscow time, matching config.time_zone.
TZ=Europe/Moscow
