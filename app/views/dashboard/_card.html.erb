<button type="button" class="card ccard" data-dashboard-target="card" data-currency="<%= card.code %>"
        data-action="dashboard#selectCurrency" aria-pressed="false">
  <div>
    <div class="ccard__code"><%= card.code %></div>
    <div class="ccard__name"><%= card.name %></div>
  </div>
  <% if card.value %>
    <div class="ccard__spark <%= trend_class(card.delta) %>"><%= sparkline(card.spark) %></div>
    <div class="ccard__value num"><%= rub(card.value, precision: 2) %><small>₽</small></div>
    <div class="ccard__src"><%= provider_name(card.provider) %> · <%= date_ru(card.on_date) %></div>
    <div class="ccard__delta num <%= trend_class(card.delta) %>" title="Изменение за сутки">
      <% if card.delta %>
        <%= render "shared/icon", name: (card.delta.negative? ? "down" : "up") %>
        <span><%= signed(card.delta, precision: 2) %></span>
        <span><%= signed(card.pct, precision: 2, suffix: "%") %></span>
      <% else %>
        <span>нет данных за прошлый день</span>
      <% end %>
    </div>
  <% else %>
    <div class="ccard__empty">Нет данных</div>
  <% end %>
</button>
